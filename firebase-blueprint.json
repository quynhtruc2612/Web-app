{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated teacher or legacy student account profile.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 200
        },
        "role": {
          "type": "string",
          "enum": ["teacher", "student"]
        },
        "studentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "className": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "userId",
        "fullName",
        "email",
        "role",
        "studentId",
        "className",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentRosterEntry": {
      "title": "StudentRosterEntry",
      "description": "Teacher-managed student roster record with unique Student ID used for class assignment, CSV import, and verification.",
      "type": "object",
      "properties": {
        "rosterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "linkedUid": {
          "type": "string",
          "minLength": 0,
          "maxLength": 128
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "rosterId",
        "studentId",
        "fullName",
        "email",
        "className",
        "accountStatus",
        "linkedUid",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentVerificationRecord": {
      "title": "StudentVerificationRecord",
      "description": "Teacher-managed verification index keyed by normalized Student ID, unreadable by students and evaluated only by Firestore rules during session creation.",
      "type": "object",
      "properties": {
        "studentIdKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "rosterId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fullNameNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "classNameNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "accountStatus": {
          "type": "string",
          "enum": ["active", "inactive"]
        },
        "canonicalStudentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "studentIdKey",
        "rosterId",
        "studentId",
        "fullName",
        "fullNameNormalized",
        "className",
        "classNameNormalized",
        "accountStatus",
        "canonicalStudentUid",
        "updatedBy",
        "updatedAt"
      ]
    },
    "StudentSession": {
      "title": "StudentSession",
      "description": "Short-lived anonymous student session verified against the teacher-managed roster.",
      "type": "object",
      "properties": {
        "sessionUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentIdKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "fullNameNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "classNameNormalized": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "status": {
          "type": "string",
          "enum": ["active", "ended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "sessionUid",
        "studentIdKey",
        "studentId",
        "fullName",
        "fullNameNormalized",
        "className",
        "classNameNormalized",
        "status",
        "createdAt",
        "updatedAt",
        "expiresAt"
      ]
    },
    "PublicClassCatalog": {
      "title": "PublicClassCatalog",
      "description": "Non-PII teacher-managed list of active class names shown in the Student Entry Form.",
      "type": "object",
      "properties": {
        "classNames": {
          "type": "array"
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["classNames", "updatedBy", "updatedAt"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Weekly speaking practice assignment created by a teacher.",
      "type": "object",
      "properties": {
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "weekNumber": {
          "type": "integer"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "instructions": {
          "type": "string",
          "minLength": 0,
          "maxLength": 2500
        },
        "questions": {
          "type": "array"
        },
        "questionCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "open", "locked"]
        },
        "deadline": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "createdBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "publishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "assignmentId",
        "weekNumber",
        "title",
        "topic",
        "instructions",
        "questions",
        "questionCount",
        "status",
        "deadline",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "Submission": {
      "title": "Submission",
      "description": "Individual question speaking submission, audio reference, transcript, and three-criterion AI assessment.",
      "type": "object",
      "properties": {
        "submissionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "canonicalStudentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentEmail": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200
        },
        "className": {
          "type": "string",
          "minLength": 0,
          "maxLength": 60
        },
        "assignmentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "weekNumber": {
          "type": "integer"
        },
        "assignmentTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 150
        },
        "questionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "questionPromptSnapshot": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "audioStorageType": {
          "type": "string",
          "enum": ["firebase_storage", "firestore_chunks", "none"]
        },
        "audioStoragePath": {
          "type": "string",
          "minLength": 0,
          "maxLength": 400
        },
        "audioMimeType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "audioChunkCount": {
          "type": "integer"
        },
        "recordingDuration": {
          "type": "number"
        },
        "processingStatus": {
          "type": "string",
          "enum": ["processing", "feedback_available", "failed", "needs_rerecording"]
        },
        "transcript": {
          "type": "string",
          "minLength": 0,
          "maxLength": 15000
        },
        "assessment": {
          "type": "object"
        },
        "overallScore": {
          "type": "number"
        },
        "whatYouDidWell": {
          "type": "array"
        },
        "areasToImprove": {
          "type": "array"
        },
        "expressionCorrections": {
          "type": "array"
        },
        "overallComment": {
          "type": "string",
          "minLength": 0,
          "maxLength": 3000
        },
        "aiModel": {
          "type": "string",
          "minLength": 0,
          "maxLength": 100
        },
        "promptVersion": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "errorMessage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1000
        },
        "resubmissionAllowed": {
          "type": "boolean"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "assessedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "submissionId",
        "studentUid",
        "canonicalStudentUid",
        "studentId",
        "studentName",
        "studentEmail",
        "className",
        "assignmentId",
        "weekNumber",
        "assignmentTitle",
        "questionId",
        "questionPromptSnapshot",
        "audioStorageType",
        "audioStoragePath",
        "audioMimeType",
        "audioChunkCount",
        "recordingDuration",
        "processingStatus",
        "transcript",
        "whatYouDidWell",
        "areasToImprove",
        "expressionCorrections",
        "overallComment",
        "aiModel",
        "promptVersion",
        "errorMessage",
        "resubmissionAllowed",
        "submittedAt",
        "updatedAt"
      ]
    },
    "AudioChunk": {
      "title": "AudioChunk",
      "description": "Authenticated base64 audio segment stored when Firebase Cloud Storage bucket rules are unavailable.",
      "type": "object",
      "properties": {
        "chunkIndex": {
          "type": "integer"
        },
        "data": {
          "type": "string",
          "minLength": 1,
          "maxLength": 750000
        },
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["chunkIndex", "data", "studentUid", "createdAt"]
    },
    "StudentProgress": {
      "title": "StudentProgress",
      "description": "Aggregated speaking progress metrics calculated strictly from actual student submissions.",
      "type": "object",
      "properties": {
        "studentUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentId": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40
        },
        "totalAssignments": {
          "type": "integer"
        },
        "completedAssignments": {
          "type": "integer"
        },
        "totalQuestionsSubmitted": {
          "type": "integer"
        },
        "averageGrammarVocabulary": {
          "type": "number"
        },
        "averageDiscourseManagement": {
          "type": "number"
        },
        "averagePronunciation": {
          "type": "number"
        },
        "averageOverallScore": {
          "type": "number"
        },
        "latestSubmissionDate": {
          "type": "string",
          "format": "date-time"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "studentUid",
        "studentId",
        "totalAssignments",
        "completedAssignments",
        "totalQuestionsSubmitted",
        "averageGrammarVocabulary",
        "averageDiscourseManagement",
        "averagePronunciation",
        "averageOverallScore",
        "latestSubmissionDate",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Teacher and legacy user profile records with strict role separation."
    },
    "/studentRoster/{rosterId}": {
      "schema": { "$ref": "#/entities/StudentRosterEntry" },
      "description": "Teacher-only roster of enrolled students with unique Student IDs."
    },
    "/studentVerification/{studentIdKey}": {
      "schema": { "$ref": "#/entities/StudentVerificationRecord" },
      "description": "Teacher-only verification index evaluated strictly inside Firestore rules during student session creation."
    },
    "/studentSessions/{sessionUid}": {
      "schema": { "$ref": "#/entities/StudentSession" },
      "description": "Short-lived Firebase Anonymous Auth sessions validated against the teacher roster."
    },
    "/publicConfig/{configId}": {
      "schema": { "$ref": "#/entities/PublicClassCatalog" },
      "description": "Non-PII class list catalog for the Student Entry Form dropdown."
    },
    "/assignments/{assignmentId}": {
      "schema": { "$ref": "#/entities/Assignment" },
      "description": "Weekly speaking practice assignments."
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student speaking submissions and AI assessments per question."
    },
    "/submissions/{submissionId}/audioChunks/{chunkIndex}": {
      "schema": { "$ref": "#/entities/AudioChunk" },
      "description": "Secured audio recording chunks owned by the submitting student and readable by teachers."
    },
    "/studentProgress/{studentUid}": {
      "schema": { "$ref": "#/entities/StudentProgress" },
      "description": "Student speaking progress summary keyed by canonical student UID."
    }
  }
}
